# Django Core Settings
SECRET_KEY=django-insecure-vibecheck-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com,.railway.app

# Google Gemini AI API Key (Optional for RAG generation; system has automated expert rule fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (for chat logs and user feedback)
# Default connects to local MongoDB instance, or provide MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/vibecheck_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=vibecheck_db

# External Third-Party API Configuration (ZenQuotes or custom API)
EXTERNAL_API_TIMEOUT=2.0
